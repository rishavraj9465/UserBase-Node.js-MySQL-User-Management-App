<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All users</title>
</head>
<body>
    <table border="black">
        <caption><h3>All users data</h3></caption>
        <thead>
            <tr>
                <th>ID</th>
                <th>USERNAME</th>
                <th>EMAIL</th>
                <th>PASSWORD</th>
            </tr>
        </thead>
        <tbody>   
                <% for (user of users) { %>
                    <tr>
                        <td><%= user.id %></td>
                        <td><%= user.username %></td>
                        <td><%= user.email %></td>
                        <td><%= user.password %></td>
                        <td>
                        <form method="GET" action="/user/<%= user.id %>/edit">
                            <button>Edit username </button>
                        </form>
                        </td>
                    </tr>
                <% } %>
                
            
        
        

        </tbody>
    </table>
</body>
</html>